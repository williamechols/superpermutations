import Hunter.ProofsExitless

/-!
# The confinement lemma and `prp_3edgebound` (Hunter appendix)

This file proves the genuinely missing input to the base-region case of Theorem 2: the
**confinement lemma** and, from it, `prp_3edgebound`.
-/

namespace Hunter
namespace ProofsConfinement

open List
open scoped Classical

variable {k : ℕ}

/-! ## Word-level ports (re-proved in the Hunter namespace from `Coeff2`) -/

/-- Erasing the last symbol of a nodup word is `dropLast`. -/
theorem erase_getLastD {w : List ℕ} (hw : w.Nodup) :
    w.erase (w.getLastD 0) = w.dropLast := by
  rcases List.eq_nil_or_concat w with rfl | ⟨l, a, rfl⟩
  · rfl
  · rw [List.concat_eq_append] at hw ⊢
    have hal : a ∉ l := by
      rw [List.nodup_append] at hw
      intro h; exact hw.2.2 a h a (List.mem_singleton_self a) rfl
    have hgl : (l ++ [a]).getLastD 0 = a := by simp
    rw [hgl, List.erase_append_right _ hal, List.erase_cons_head, List.append_nil,
        List.dropLast_concat]

/-- The marked 2-loop generated by `w = π₁⋯π_k`: marker the last symbol, class the rotation
class of the rest.  (Coeff2 `genLoop`.) -/
def genLoop (w : List ℕ) : ℕ × RotClass := (w.getLastD 0, rotClass w.dropLast)

/-- One-step rotation preserves the marker-deletion class (`Coeff2` `V_closed_rotate`, the
single step). -/
theorem rotClass_erase_rotate_one {α : ℕ} {y : List ℕ} (hnd : y.Nodup) :
    rotClass ((y.rotate 1).erase α) = rotClass (y.erase α) := by
  rcases y with _ | ⟨a, t⟩
  · simp
  · have hy : (a :: t).rotate 1 = t ++ [a] := by simp
    rw [hy]
    apply Quotient.sound
    by_cases hα : α = a
    · subst hα
      have hat : α ∉ t := (List.nodup_cons.mp hnd).1
      rw [List.erase_append_right _ hat, List.erase_cons_head, List.append_nil,
        List.erase_cons_head]
    · by_cases hmem : α ∈ t
      · rw [List.erase_append_left _ hmem,
          List.erase_cons_tail (by simpa using Ne.symm hα)]
        exact List.IsRotated.symm
          (⟨1, by simp⟩ : (a :: t.erase α) ~r (t.erase α ++ [a]))
      · have h1 : (t ++ [a]).erase α = t ++ [a] := by
          apply List.erase_of_not_mem
          simp only [List.mem_append, List.mem_singleton]
          rintro (h | h)
          · exact hmem h
          · exact hα h
        have h2 : (a :: t).erase α = a :: t := by
          apply List.erase_of_not_mem
          simp only [List.mem_cons]
          rintro (h | h)
          · exact hα h
          · exact hmem h
        rw [h1, h2]
        exact List.IsRotated.symm (⟨1, by simp⟩ : (a :: t) ~r (t ++ [a]))

/-- Any rotation preserves the marker-deletion class. -/
theorem rotClass_erase_rotate {α : ℕ} {w : List ℕ} (hnd : w.Nodup) (r : ℕ) :
    rotClass ((w.rotate r).erase α) = rotClass (w.erase α) := by
  induction r with
  | zero => simp
  | succ r ih =>
    have hrot : w.rotate (r + 1) = (w.rotate r).rotate 1 := by rw [List.rotate_rotate]
    rw [hrot, rotClass_erase_rotate_one ((List.rotate_perm w r).nodup_iff.mpr hnd), ih]

/-- The weight-2 word dichotomy: if `u.drop 2 = v.take (k−2)` for permutation words, then
`v` is the double rotation or the door of `u`.  (`Coeff2` `wt_two_word_cases`.) -/
theorem wt_two_word_cases {u v : List ℕ} (hk : 2 ≤ k) (hu : IsPermWord k u)
    (hv : IsPermWord k v) (hover : u.drop 2 = v.take (k - 2)) :
    v = u.rotate 2 ∨ v = door u := by
  obtain ⟨a, t, rfl⟩ := List.exists_cons_of_ne_nil (hu.ne_nil (by omega))
  obtain ⟨b, s, rfl⟩ : ∃ b s, t = b :: s := by
    rcases t with _ | ⟨b, s⟩
    · have := hu.length; simp at this; omega
    · exact ⟨b, s, rfl⟩
  have hulen : (a :: b :: s).length = k := hu.length
  have hslen : s.length = k - 2 := by simp at hulen; omega
  have hdrop : (a :: b :: s).drop 2 = s := rfl
  set r := v.drop (k - 2) with hr
  have hvsplit : v = s ++ r := by
    conv_lhs => rw [← List.take_append_drop (k - 2) v]
    rw [← hover, hdrop]
  have hrlen : r.length = 2 := by
    rw [hr, List.length_drop, hv.length]; omega
  have hnd : (a :: b :: s).Nodup := hu.nodup
  have has : a ∉ s := by
    have := (List.nodup_cons.mp hnd).1; simp at this; exact this.2
  have hbs : b ∉ s := (List.nodup_cons.mp (List.nodup_cons.mp hnd).2).1
  have hab : a ≠ b := by
    have := (List.nodup_cons.mp hnd).1; simp at this; exact this.1
  have hsymbols : v.toFinset = (a :: b :: s).toFinset := by
    rw [hv.toFinset_eq, hu.toFinset_eq]
  have hav : a ∈ v := by rw [← List.mem_toFinset, hsymbols]; simp
  have hbv : b ∈ v := by rw [← List.mem_toFinset, hsymbols]; simp
  have har : a ∈ r := by
    rw [hvsplit, List.mem_append] at hav
    rcases hav with h | h
    · exact absurd h has
    · exact h
  have hbr : b ∈ r := by
    rw [hvsplit, List.mem_append] at hbv
    rcases hbv with h | h
    · exact absurd h hbs
    · exact h
  obtain ⟨x, y, hxy⟩ : ∃ x y, r = [x, y] := by
    rcases r with _ | ⟨x, r'⟩
    · simp at hrlen
    · rcases r' with _ | ⟨y, r''⟩
      · simp at hrlen
      · rcases r'' with _ | _
        · exact ⟨x, y, rfl⟩
        · simp at hrlen
  rw [hxy] at har hbr
  simp only [List.mem_cons, List.not_mem_nil, or_false] at har hbr
  have hrot : (a :: b :: s).rotate 2 = s ++ [a, b] := by
    rw [List.rotate_eq_drop_append_take
      (by simp only [List.length_cons]; omega : 2 ≤ (a :: b :: s).length)]
    rfl
  have hdoor : door (a :: b :: s) = s ++ [b, a] := by
    show (a :: b :: s).drop 2 ++ [(a :: b :: s).getD 1 0, (a :: b :: s).getD 0 0] = _
    rfl
  rcases har with rfl | rfl
  · rcases hbr with rfl | rfl
    · exact absurd rfl hab
    · left; rw [hvsplit, hxy, hrot]
  · rcases hbr with rfl | rfl
    · right; rw [hvsplit, hxy, hdoor]
    · exact absurd rfl hab.symm

/-- Deleting the marker from the rotation and from the door land in the same marked loop:
`L(door σ) = L(ρσ)`.  (`Coeff2` `genLoop_door_eq_genLoop_rho`.) -/
theorem genLoop_door_eq_genLoop_rho {σ : List ℕ} (hk : 2 ≤ k) (hσ : IsPermWord k σ) :
    genLoop (door σ) = genLoop (rho σ) := by
  obtain ⟨a, t, rfl⟩ := List.exists_cons_of_ne_nil (hσ.ne_nil (by omega))
  obtain ⟨b, s, rfl⟩ : ∃ b s, t = b :: s := by
    rcases t with _ | ⟨b, s⟩
    · have := hσ.length; simp at this; omega
    · exact ⟨b, s, rfl⟩
  have hrho : rho (a :: b :: s) = b :: s ++ [a] := by
    show (a :: b :: s).rotate 1 = _; simp
  have hdoor : door (a :: b :: s) = s ++ [b, a] := rfl
  rw [hrho, hdoor]
  unfold genLoop
  have h1 : (s ++ [b, a]).getLastD 0 = a := by
    have : s ++ [b, a] = (s ++ [b]) ++ [a] := by simp
    rw [this, List.getLastD_concat]
  have h2 : (b :: s ++ [a]).getLastD 0 = a := by
    have : b :: s ++ [a] = (b :: s) ++ [a] := by simp
    rw [this, List.getLastD_concat]
  have h3 : (s ++ [b, a]).dropLast = s ++ [b] := by
    have : s ++ [b, a] = (s ++ [b]) ++ [a] := by simp
    rw [this, List.dropLast_concat]
  have h4 : (b :: s ++ [a]).dropLast = b :: s := by
    have : b :: s ++ [a] = (b :: s) ++ [a] := by simp
    rw [this, List.dropLast_concat]
  rw [h1, h2, h3, h4]
  refine Prod.ext rfl ?_
  show rotClass (s ++ [b]) = rotClass (b :: s)
  apply Quotient.sound
  exact List.IsRotated.symm ⟨1, by simp⟩

/-- Injectivity of insertion position (`Coeff2` `insert_pos_inj`). -/
theorem insert_pos_inj {w : List ℕ} {α : ℕ} (hα : α ∉ w) {j j' : ℕ}
    (hj : j ≤ w.length) (hj' : j' ≤ w.length)
    (heq : w.take j ++ α :: w.drop j = w.take j' ++ α :: w.drop j') : j = j' := by
  have key : ∀ {a b : ℕ}, a < b → b ≤ w.length →
      w.take a ++ α :: w.drop a = w.take b ++ α :: w.drop b → False := by
    intro a b hab hb heq'
    have hlta : (w.take a).length = a := by rw [List.length_take]; omega
    have hltb : (w.take b).length = b := by rw [List.length_take]; omega
    have e := congrArg (fun l => l[a]?) heq'
    rw [List.getElem?_append_right (by omega : (w.take a).length ≤ a), hlta,
      Nat.sub_self, List.getElem?_append_left (by rw [hltb]; omega : a < (w.take b).length),
      List.getElem?_take_of_lt hab, List.getElem?_eq_getElem (by omega : a < w.length)]
      at e
    have hαa : α = w[a]'(by omega) := by
      have e0 : (α :: w.drop a)[0]? = some α := rfl
      rw [e0] at e; exact Option.some_inj.mp e
    apply hα; rw [hαa]; exact List.getElem_mem (by omega)
  rcases Nat.lt_trichotomy j j' with h | h | h
  · exact absurd heq (fun he => key h hj' he)
  · exact h
  · exact absurd heq.symm (fun he => key h hj he)

/-! ## `Vset`: the marked-2-loop vertex set, and its cardinality bound -/

/-- The vertex set of the marked 2-loop `(α, K)`: permutation words `v` with
`rotClass (del_α v) = K`.  (`Coeff2` `V n L`, as a `Finset (Vtx k)`.) -/
noncomputable def Vset (k : ℕ) (α : ℕ) (K : RotClass) : Finset (Vtx k) :=
  Finset.univ.filter (fun v => rotClass ((v : List ℕ).erase α) = K)

theorem mem_Vset {α : ℕ} {K : RotClass} {v : Vtx k} :
    v ∈ Vset k α K ↔ rotClass ((v : List ℕ).erase α) = K := by
  rw [Vset, Finset.mem_filter]
  exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ _, h⟩⟩

/-- `Vset` is closed under `σ` (rotation preserves the marker-deletion class). -/
theorem sigma_mem_Vset {α : ℕ} {K : RotClass} {v : Vtx k} (h : v ∈ Vset k α K) :
    sigma v ∈ Vset k α K := by
  rw [mem_Vset] at h ⊢
  show rotClass (((v : List ℕ).rotate 1).erase α) = K
  rw [rotClass_erase_rotate_one v.2.nodup, h]

/-- **Cardinality bound**: a marked 2-loop generated by a permutation word `A` has at most
`k(k−1)` vertices.  (`Coeff2` `card_V`, upper bound only — via the insertion surjection.) -/
theorem card_Vset_le {A : Vtx k} (hk : 2 ≤ k) {α : ℕ} {K : RotClass}
    (hα : α = (A : List ℕ).getLastD 0) (hK : K = rotClass (A : List ℕ).dropLast) :
    (Vset k α K).card ≤ k * (k - 1) := by
  classical
  rcases List.eq_nil_or_concat (A : List ℕ) with hnil | ⟨u₀, aLast, hAeq⟩
  · exact absurd hnil (A.2.ne_nil (by omega))
  · rw [List.concat_eq_append] at hAeq
    have hnd : ((u₀ ++ [aLast]).Nodup) := hAeq ▸ A.2.nodup
    have hαa : α = aLast := by rw [hα, hAeq, List.getLastD_concat]
    have hdl : (A : List ℕ).dropLast = u₀ := by rw [hAeq, List.dropLast_concat]
    have hKu : K = rotClass u₀ := by rw [hK, hdl]
    have hu0nd : u₀.Nodup := (List.nodup_append.mp hnd).1
    have hαu0 : aLast ∉ u₀ :=
      fun h => (List.nodup_append.mp hnd).2.2 aLast h aLast (by simp) rfl
    have hu0len : u₀.length = k - 1 := by
      have := A.2.length; rw [hAeq] at this; simp at this; omega
    have hlenpos : 0 < u₀.length := by rw [hu0len]; omega
    have hαIcc : aLast ∈ Finset.Icc 1 k := by
      rw [← A.2.toFinset_eq, List.mem_toFinset, hAeq]; simp
    set f : ℕ × ℕ → List ℕ :=
      fun p => (u₀.rotate p.1).take p.2 ++ aLast :: (u₀.rotate p.1).drop p.2 with hf
    have hsub : (Vset k α K).image Subtype.val ⊆
        ((Finset.range (k - 1)) ×ˢ (Finset.range k)).image f := by
      intro w hw
      rw [Finset.mem_image] at hw
      obtain ⟨v, hvV, rfl⟩ := hw
      rw [mem_Vset, hαa, hKu] at hvV
      have hασ : aLast ∈ (v : List ℕ) := by
        rw [← List.mem_toFinset, v.2.toFinset_eq]; exact hαIcc
      obtain ⟨t, r', hsplit⟩ := List.append_of_mem hασ
      have hvnd : (v : List ℕ).Nodup := v.2.nodup
      rw [hsplit, List.nodup_append] at hvnd
      have hαt : aLast ∉ t := fun h => hvnd.2.2 aLast h aLast (List.mem_cons_self ..) rfl
      have herase2 : (v : List ℕ).erase aLast = t ++ r' := by
        rw [hsplit, List.erase_append_right _ hαt, List.erase_cons_head]
      have hclass : rotClass (t ++ r') = rotClass u₀ := by rw [← herase2]; exact hvV
      obtain ⟨m, hm⟩ := rotClass_eq_iff.mp hclass.symm
      have hrot : u₀.rotate (m % u₀.length) = t ++ r' := by rw [List.rotate_mod]; exact hm
      have hjlen : t.length + 1 + r'.length = k := by
        have := v.2.length; rw [hsplit] at this; simp at this; omega
      refine Finset.mem_image.mpr ⟨(m % u₀.length, t.length), ?_, ?_⟩
      · exact Finset.mem_product.mpr
          ⟨Finset.mem_range.mpr (by rw [← hu0len]; exact Nat.mod_lt _ hlenpos),
           Finset.mem_range.mpr (by omega)⟩
      · show (u₀.rotate (m % u₀.length)).take t.length ++
            aLast :: (u₀.rotate (m % u₀.length)).drop t.length = (v : List ℕ)
        rw [hrot, List.take_left, List.drop_left]
        exact hsplit.symm
    have hinjval : Function.Injective (Subtype.val : Vtx k → List ℕ) :=
      fun a b h => Subtype.ext h
    calc (Vset k α K).card
        = ((Vset k α K).image Subtype.val).card :=
          (Finset.card_image_of_injective _ hinjval).symm
      _ ≤ (((Finset.range (k - 1)) ×ˢ (Finset.range k)).image f).card :=
          Finset.card_le_card hsub
      _ ≤ ((Finset.range (k - 1)) ×ˢ (Finset.range k)).card := Finset.card_image_le
      _ = (k - 1) * k := by
          rw [Finset.card_product, Finset.card_range, Finset.card_range]
      _ = k * (k - 1) := Nat.mul_comm _ _

/-! ## Bridging `genLoop`/`cyc` to `Vset` -/

open ProofsExitless Proved

/-- A vertex whose generated marked loop is `(α, K)` lies in `Vset α K`. -/
theorem mem_Vset_of_genLoop {α : ℕ} {K : RotClass} {v : Vtx k}
    (h : genLoop (v : List ℕ) = (α, K)) : v ∈ Vset k α K := by
  rw [mem_Vset]
  have h1 : (v : List ℕ).getLastD 0 = α := congrArg Prod.fst h
  have h2 : rotClass (v : List ℕ).dropLast = K := congrArg Prod.snd h
  rw [← h1, erase_getLastD v.2.nodup]; exact h2

/-- `Vset` is closed under all `σ`-iterates. -/
theorem sigma_iter_mem_Vset {α : ℕ} {K : RotClass} {v : Vtx k}
    (h : v ∈ Vset k α K) (r : ℕ) : sigma^[r] v ∈ Vset k α K := by
  induction r with
  | zero => simpa using h
  | succ r ih => rw [Function.iterate_succ_apply']; exact sigma_mem_Vset ih

/-- A whole 1-cycle lies in `Vset` once its base point does. -/
theorem cyc_subset_Vset {α : ℕ} {K : RotClass} {v : Vtx k} (hk1 : 1 ≤ k)
    (h : v ∈ Vset k α K) : cyc v ⊆ Vset k α K := by
  intro u hu
  obtain ⟨r, _, rfl⟩ := (mem_cyc_iff_exists hk1).mp hu
  exact sigma_iter_mem_Vset h r

/-- Distinct 1-cycles are disjoint. -/
theorem cyc_disjoint {u v : Vtx k} (h : rotClass u.1 ≠ rotClass v.1) :
    Disjoint (cyc u) (cyc v) := by
  rw [Finset.disjoint_left]
  intro x hxu hxv
  rw [mem_cyc] at hxu hxv
  exact h (hxu.symm.trans hxv)

/-! ## The door lemma: a weight-2 boundary edge is a `τ`/door move -/

/-- **Weight-2 boundary ⟹ door.**  At a block boundary (`k ∣ i+1`) a weight-2 edge lands on
the door of its source (a `σ²`-landing would re-enter the current 1-cycle). -/
theorem door_of_boundary (hk : 2 ≤ k) {p : HPath k} (hp : p.Exitless) {i : ℕ}
    (hi : i + 1 < p.numVerts) (hd : k ∣ (i + 1))
    (hw : ew k (p.vert i) (p.vert (i + 1)) = 2) :
    (p.vert (i + 1) : List ℕ) = door (p.vert i : List ℕ) := by
  have hk1 : 1 ≤ k := by omega
  have hu : IsPermWord k (p.vert i : List ℕ) := (p.vert i).2
  have hv : IsPermWord k (p.vert (i + 1) : List ℕ) := (p.vert (i + 1)).2
  have hew : wt k (p.vert i : List ℕ) (p.vert (i + 1) : List ℕ) = 2 := hw
  have hspec := (wt_spec (u := (p.vert i : List ℕ)) (v := (p.vert (i + 1) : List ℕ))
    hk1 (le_of_eq hu.length)).2.2
  rw [hew] at hspec
  rcases wt_two_word_cases hk hu hv hspec with hrot | hdoor
  · exfalso
    have hsigma2 : p.vert (i + 1) = sigma^[2] (p.vert i) := by
      apply Subtype.ext
      rw [hrot, sigma_iter_val]
    set B := k * (i / k) with hBdef
    have hBdvd : k ∣ B := ⟨i / k, rfl⟩
    have him : i % k = k - 1 := mod_eq_pred_of_dvd_succ hk1 hd
    have hiB : i = B + (k - 1) := by
      rw [hBdef]; have := Nat.div_add_mod i k; omega
    have hB1n : B + 1 < p.numVerts := by omega
    have hverti : p.vert i = sigma^[k - 1] (p.vert B) := by
      have h := vert_eq_sigma_iter hk1 hp i (by omega)
      rwa [him, ← hBdef] at h
    have hstep : sigma^[2] (p.vert i) = sigma^[1] (p.vert B) := by
      rw [hverti, ← Function.iterate_add_apply, show 2 + (k - 1) = 1 + k from by omega,
          Function.iterate_add_apply, sigma_iter_period]
    have hb1 : p.vert (B + 1) = sigma^[1] (p.vert B) :=
      block_is_full_cycle hk1 hp hBdvd (by omega) hB1n
    have heq : p.vert (i + 1) = p.vert (B + 1) := by rw [hsigma2, hstep, ← hb1]
    have := vert_inj p hi hB1n heq
    omega
  · exact hdoor

/-! ## The confinement lemma -/

/-- **Confinement.**  In an exitless path one cannot have `k` consecutive complete blocks
joined by weight-2 (`τ`/door) boundary edges: the `k` block starts would share one marked
2-loop `V(α,K)` of only `k(k−1)` vertices, yet form `k` disjoint 1-cycles (`k²` vertices). -/
theorem confinement (hk : 2 ≤ k) {p : HPath k} (hp : p.Exitless) {t₀ : ℕ}
    (hlast : k * (t₀ + k - 1) < p.numVerts)
    (hdoors : ∀ t, t₀ < t → t ≤ t₀ + k - 1 →
        ew k (p.vert (k * t - 1)) (p.vert (k * t)) = 2) : False := by
  have hk1 : 1 ≤ k := by omega
  set A : ℕ → Vtx k := fun t => p.vert (k * t) with hA
  set α : ℕ := (A t₀ : List ℕ).getLastD 0 with hαdef
  set K : RotClass := rotClass (A t₀ : List ℕ).dropLast with hKdef
  -- the shared marked-loop invariant along the run
  have hinv : ∀ j, j ≤ k - 1 → genLoop (A (t₀ + j) : List ℕ) = (α, K) := by
    intro j
    induction j with
    | zero => intro _; rw [Nat.add_zero]; rfl
    | succ j ih =>
      intro hj
      have hIH := ih (by omega)
      set s := t₀ + j with hs
      have hs1le : s + 1 ≤ t₀ + k - 1 := by omega
      set i := k * (s + 1) - 1 with hidef
      have hks : k * (s + 1) = k * s + k := by ring
      have hib : i = k * s + (k - 1) := by omega
      have hi1eq : i + 1 = k * (s + 1) := by omega
      have hkslt : k * (s + 1) ≤ k * (t₀ + k - 1) := Nat.mul_le_mul (le_refl k) hs1le
      have hin : i + 1 < p.numVerts := by omega
      have hd : k ∣ (i + 1) := by rw [hi1eq]; exact ⟨s + 1, rfl⟩
      have hwt : ew k (p.vert i) (p.vert (i + 1)) = 2 := by
        have h := hdoors (s + 1) (by omega) (by omega)
        rw [show k * (s + 1) - 1 = i from hidef.symm, show k * (s + 1) = i + 1 from hi1eq.symm]
          at h
        exact h
      have hAeq : A (s + 1) = p.vert (i + 1) := by
        show p.vert (k * (s + 1)) = p.vert (i + 1)
        rw [hi1eq]
      have hdoorx : (A (s + 1) : List ℕ) = door (p.vert i : List ℕ) := by
        rw [hAeq]; exact door_of_boundary hk hp hin hd hwt
      -- x = p.vert i is the last vertex of block s
      have hxfull : p.vert i = sigma^[k - 1] (A s) := by
        have h := block_is_full_cycle hk1 hp (⟨s, rfl⟩ : k ∣ k * s) (by omega : k - 1 < k)
          (by omega : k * s + (k - 1) < p.numVerts)
        rw [hib]; exact h
      have hsigmax : sigma (p.vert i) = A s := by
        rw [hxfull, sigma_iter_succ' (k - 1) (A s), show (k - 1) + 1 = k from by omega,
            sigma_iter_period]
      have hrhox : rho (p.vert i : List ℕ) = (A s : List ℕ) := by
        show (p.vert i : List ℕ).rotate 1 = (A s : List ℕ)
        rw [← hsigmax]; rfl
      calc genLoop (A (t₀ + (j + 1)) : List ℕ)
          = genLoop (A (s + 1) : List ℕ) := by rw [show t₀ + (j + 1) = s + 1 from by omega]
        _ = genLoop (door (p.vert i : List ℕ)) := by rw [hdoorx]
        _ = genLoop (rho (p.vert i : List ℕ)) := genLoop_door_eq_genLoop_rho hk (p.vert i).2
        _ = genLoop (A s : List ℕ) := by rw [hrhox]
        _ = (α, K) := hIH
  -- distinctness of the block 1-cycles
  have hne : ∀ a b, a < b → b ≤ k - 1 →
      rotClass (A (t₀ + a) : List ℕ) ≠ rotClass (A (t₀ + b) : List ℕ) := by
    intro a b hab hb
    have hdvd : k ∣ k * (t₀ + a) := ⟨t₀ + a, rfl⟩
    have hBk : k * (t₀ + a) + k ≤ k * (t₀ + b) := by
      have he : k * (t₀ + a) + k = k * (t₀ + a + 1) := by ring
      rw [he]; exact Nat.mul_le_mul (le_refl k) (by omega)
    have hB'n : k * (t₀ + b) < p.numVerts := by
      have hle : k * (t₀ + b) ≤ k * (t₀ + k - 1) := Nat.mul_le_mul (le_refl k) (by omega)
      omega
    exact no_reentry hk1 hp hdvd hBk hB'n
  -- all k block starts lie in one marked 2-loop
  have hAmem : ∀ j, j ≤ k - 1 → A (t₀ + j) ∈ Vset k α K :=
    fun j hj => mem_Vset_of_genLoop (hinv j hj)
  set bigU : Finset (Vtx k) := (Finset.range k).biUnion (fun j => cyc (A (t₀ + j))) with hbigU
  have hdisj : ∀ j ∈ Finset.range k, ∀ j' ∈ Finset.range k, j ≠ j' →
      Disjoint (cyc (A (t₀ + j))) (cyc (A (t₀ + j'))) := by
    intro j hj j' hj' hjne
    rw [Finset.mem_range] at hj hj'
    apply cyc_disjoint
    rcases Nat.lt_or_ge j j' with h | h
    · exact hne j j' h (by omega)
    · exact (hne j' j (by omega) (by omega)).symm
  have hcardk : bigU.card = k * k := by
    rw [hbigU, Finset.card_biUnion hdisj,
        Finset.sum_congr rfl (fun j _ => card_cyc hk1 (A (t₀ + j))),
        Finset.sum_const, Finset.card_range, smul_eq_mul]
  have hsub : bigU ⊆ Vset k α K := by
    rw [hbigU]
    intro x hx
    rw [Finset.mem_biUnion] at hx
    obtain ⟨j, hj, hxj⟩ := hx
    rw [Finset.mem_range] at hj
    exact cyc_subset_Vset hk1 (hAmem j (by omega)) hxj
  have hVle : (Vset k α K).card ≤ k * (k - 1) := card_Vset_le (A := A t₀) hk hαdef hKdef
  have hle : k * k ≤ k * (k - 1) := by
    rw [← hcardk]; exact le_trans (Finset.card_le_card hsub) hVle
  have hlt : k * (k - 1) < k * k := mul_lt_mul_of_pos_left (by omega) (by omega)
  omega

/-! ## Counting: from confinement to `prp_3edgebound` -/

/-- `1 ≤ T ⌈/⌉ d` forces `1 ≤ T` (`d ≥ 1`). -/
theorem one_le_of_ceilDiv {d T : ℕ} (h : 1 ≤ T ⌈/⌉ d) : 1 ≤ T := by
  rcases Nat.eq_zero_or_pos T with h0 | h1
  · rw [h0] at h; simp at h
  · exact h1

/-- **Covering lemma.**  If every window of `d` consecutive positions in `[1, T−1]` contains a
point of `H`, then `H` has at least `⌈T/d⌉ − 1` points. -/
theorem cover_bound {d T : ℕ} (hd : 1 ≤ d) (H : Finset ℕ)
    (hwin : ∀ a, 1 ≤ a → a + d ≤ T → ∃ h ∈ H, a ≤ h ∧ h ≤ a + d - 1) :
    T ⌈/⌉ d - 1 ≤ H.card := by
  have hsub : Finset.range (T ⌈/⌉ d - 1) ⊆ H.image (fun h => (h - 1) / d) := by
    intro g hg
    rw [Finset.mem_range] at hg
    have hT1 : 1 ≤ T := one_le_of_ceilDiv (d := d) (by omega)
    have hpred : T ⌈/⌉ d = (T - 1) / d + 1 := ceilDiv_succ_pred hT1 (by omega)
    have hgd : g + 1 ≤ (T - 1) / d := by omega
    have hdm : (T - 1) / d * d ≤ T - 1 := Nat.div_mul_le_self (T - 1) d
    have hb1 : (g + 1) * d ≤ T - 1 :=
      le_trans (Nat.mul_le_mul_right d hgd) hdm
    have hexp : g * d + 1 + d = (g + 1) * d + 1 := by ring
    obtain ⟨h, hhH, hlo, hhi⟩ := hwin (g * d + 1) (by omega) (by omega)
    refine Finset.mem_image.mpr ⟨h, hhH, ?_⟩
    have hdg : d * g ≤ h - 1 := by
      have : g * d = d * g := by ring
      omega
    set r := h - 1 - d * g with hrdef
    have hr1 : h - 1 = d * g + r := by omega
    have hr2 : r < d := by
      have hcomm : g * d = d * g := by ring
      omega
    rw [hr1, Nat.mul_add_div (by omega : 0 < d), Nat.div_eq_of_lt hr2, Nat.add_zero]
  calc T ⌈/⌉ d - 1 = (Finset.range (T ⌈/⌉ d - 1)).card := (Finset.card_range _).symm
    _ ≤ (H.image (fun h => (h - 1) / d)).card := Finset.card_le_card hsub
    _ ≤ H.card := Finset.card_image_le

/-- **Nested-ceiling identity** `⌈⌈ℓ/b⌉/c⌉ = ⌈ℓ/(b·c)⌉`. -/
theorem ceilDiv_ceilDiv {ℓ b c : ℕ} (hb : 0 < b) (hc : 0 < c) :
    (ℓ ⌈/⌉ b) ⌈/⌉ c = ℓ ⌈/⌉ (b * c) := by
  have key : ∀ n, (ℓ ⌈/⌉ b) ⌈/⌉ c ≤ n ↔ ℓ ⌈/⌉ (b * c) ≤ n := by
    intro n
    rw [ceilDiv_le_iff_le_mul hc, ceilDiv_le_iff_le_mul hb,
        ceilDiv_le_iff_le_mul (Nat.mul_pos hb hc), Nat.mul_assoc]
  exact le_antisymm ((key _).mpr le_rfl) ((key _).mp le_rfl)

end ProofsConfinement

namespace Proved

open ProofsExitless ProofsConfinement
open scoped Classical

/-- **prp-3edgebound** — an exitless path of length `ℓ` has `≥ ⌈ℓ/(k(k−1))⌉ − 1` weight-`≥3`
edges.  Proved via the confinement lemma and the covering count. -/
theorem prp_3edgebound {k : ℕ} (hk : 2 ≤ k) {p : HPath k} (hp : p.Exitless) :
    edgeCountGe p 3 ≥ p.numVerts ⌈/⌉ (k * (k - 1)) - 1 := by
  have hk1 : 1 ≤ k := by omega
  set ℓ := p.numVerts with hℓdef
  have hℓ1 : 1 ≤ ℓ := p.numVerts_pos
  set T := ℓ ⌈/⌉ k with hTdef
  have hTexp : T = (ℓ - 1) / k + 1 := by
    have h0k : 0 < k := by omega
    have hc := ceilDiv_succ_pred hℓ1 h0k
    rw [hTdef, hc]
  have hTe : T - 1 = (ℓ - 1) / k := by rw [hTexp, Nat.add_sub_cancel]
  have hdml : (ℓ - 1) / k * k ≤ ℓ - 1 := Nat.div_mul_le_self (ℓ - 1) k
  have hkT1 : k * (T - 1) ≤ ℓ - 1 := by
    rw [hTe, Nat.mul_comm]; exact hdml
  set HB : Finset ℕ := (Finset.Icc 1 (T - 1)).filter
    (fun t => 3 ≤ ew k (p.vert (k * t - 1)) (p.vert (k * t))) with hHBdef
  -- window condition, from confinement
  have hwin : ∀ a, 1 ≤ a → a + (k - 1) ≤ T → ∃ h ∈ HB, a ≤ h ∧ h ≤ a + (k - 1) - 1 := by
    intro a ha haT
    by_contra hcon
    refine confinement hk hp (t₀ := a - 1) ?_ ?_
    · have hle : k * ((a - 1) + k - 1) ≤ k * (T - 1) := Nat.mul_le_mul (le_refl k) (by omega)
      omega
    · intro t ht1 ht2
      have hktpos : 0 < k * t := Nat.mul_pos (by omega) (by omega)
      have hi1 : k * t - 1 + 1 = k * t := by omega
      have hktlt : k * t < ℓ := by
        have hle : k * t ≤ k * (T - 1) := Nat.mul_le_mul (le_refl k) (by omega)
        omega
      have hin : (k * t - 1) + 1 < ℓ := by rw [hi1]; exact hktlt
      have hpe := prp_periodicedges hk1 hp hin
      have hge1 := ew_ge_one hk1 (p.vert (k * t - 1)) (p.vert ((k * t - 1) + 1))
      have hdvd : k ∣ ((k * t - 1) + 1) := by rw [hi1]; exact ⟨t, rfl⟩
      have hne1 : ew k (p.vert (k * t - 1)) (p.vert ((k * t - 1) + 1)) ≠ 1 :=
        fun he => (hpe.mp he) hdvd
      rw [hi1] at hge1 hne1
      have hn3 : ¬ 3 ≤ ew k (p.vert (k * t - 1)) (p.vert (k * t)) := by
        intro h3
        apply hcon
        refine ⟨t, ?_, by omega, by omega⟩
        rw [hHBdef, Finset.mem_filter, Finset.mem_Icc]
        exact ⟨⟨by omega, by omega⟩, h3⟩
      omega
  -- the block-heavy count equals the edge count of weight ≥ 3
  have hcard : HB.card = edgeCountGe p 3 := by
    rw [edgeCountGe, ← hℓdef]
    apply Finset.card_nbij' (fun t => k * t - 1) (fun i => (i + 1) / k)
    · intro t ht
      simp only [Finset.mem_coe, hHBdef, Finset.mem_filter, Finset.mem_Icc] at ht
      obtain ⟨⟨ht1, ht2⟩, ht3⟩ := ht
      have hktp : 1 ≤ k * t := Nat.mul_pos (by omega) (by omega)
      have hi1 : k * t - 1 + 1 = k * t := by omega
      have hktle : k * t ≤ ℓ - 1 := le_trans (Nat.mul_le_mul (le_refl k) ht2) hkT1
      show k * t - 1 ∈ (Finset.range (ℓ - 1)).filter
        (fun i => 3 ≤ ew k (p.vert i) (p.vert (i + 1)))
      rw [Finset.mem_filter, Finset.mem_range]
      refine ⟨by omega, ?_⟩
      rw [hi1]; exact ht3
    · intro i hi
      simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hi
      obtain ⟨hilt, hi3⟩ := hi
      have hin : i + 1 < ℓ := by omega
      have hkdvd : k ∣ (i + 1) := by
        by_contra hnd
        have := (prp_periodicedges hk1 hp hin).mpr hnd
        omega
      have hkt : k * ((i + 1) / k) = i + 1 := Nat.mul_div_cancel' hkdvd
      have hkt1 : k * ((i + 1) / k) - 1 = i := by rw [hkt, Nat.add_sub_cancel]
      have htle : (i + 1) / k ≤ T - 1 := by
        rw [hTe]
        apply Nat.div_le_div_right; omega
      have htpos : 1 ≤ (i + 1) / k := by
        rcases Nat.eq_zero_or_pos ((i + 1) / k) with h0 | h1
        · rw [h0, Nat.mul_zero] at hkt; omega
        · exact h1
      show (i + 1) / k ∈ (Finset.Icc 1 (T - 1)).filter
        (fun t => 3 ≤ ew k (p.vert (k * t - 1)) (p.vert (k * t)))
      rw [Finset.mem_filter, Finset.mem_Icc]
      refine ⟨⟨htpos, htle⟩, ?_⟩
      rw [hkt1, hkt]; exact hi3
    · intro t ht
      simp only [Finset.mem_coe, hHBdef, Finset.mem_filter, Finset.mem_Icc] at ht
      have hktp : 1 ≤ k * t := Nat.mul_pos (by omega) (by omega)
      have hi1 : k * t - 1 + 1 = k * t := by omega
      show (k * t - 1 + 1) / k = t
      rw [hi1, Nat.mul_div_cancel_left _ (by omega : 0 < k)]
    · intro i hi
      simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hi
      obtain ⟨hilt, hi3⟩ := hi
      have hin : i + 1 < ℓ := by omega
      have hkdvd : k ∣ (i + 1) := by
        by_contra hnd
        have := (prp_periodicedges hk1 hp hin).mpr hnd
        omega
      have hkt : k * ((i + 1) / k) = i + 1 := Nat.mul_div_cancel' hkdvd
      show k * ((i + 1) / k) - 1 = i
      rw [hkt, Nat.add_sub_cancel]
  -- covering bound + nested ceiling
  have hcov := cover_bound (d := k - 1) (T := T) (by omega) HB hwin
  have hnest : T ⌈/⌉ (k - 1) = ℓ ⌈/⌉ (k * (k - 1)) := by
    rw [hTdef]; exact ceilDiv_ceilDiv (by omega) (by omega)
  rw [hcard, hnest] at hcov
  exact hcov

/-- **thm2 (base region), unconditional** — `j_k(ℓ) ≤ i_k(ℓ)` for `0 < ℓ ≤ k(k−1)(k−2)`.
Obtained by discharging the `3+`-edge hypothesis of `ProofsExitless.Proved.thm2_base` with
the now-proved `prp_3edgebound`. -/
theorem thm2_base_unconditional {k ℓ : ℕ} (hk : 3 ≤ k) (hℓ0 : 0 < ℓ)
    (hℓ : ℓ ≤ k * (k - 1) * (k - 2)) (hex : HasExitlessPath k ℓ) :
    j k ℓ ≤ iExitless k ℓ :=
  thm2_base hk hℓ0 hℓ hex (fun q hq => prp_3edgebound (by omega) hq)

end Proved
